      "endMs": 10033.333333333334,
      "timestampMs": null,
      "confidence": null
    }
  ],
  "waiting": [
    {
      "text": "可是，才过了一天，小苗看起来和昨天差不多。",
      "startMs": 800,
      "endMs": 4733.333333333333,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "农夫急了：怎么还不长呀？我来帮帮你们！",
      "startMs": 5200,
      "endMs": 8400,
      "timestampMs": null,
      "confidence": null
    }
  ],
  "pulling": [
    {
      "text": "他弯下腰，把小苗一棵一棵，往上拔了一点点。",
      "startMs": 800,
      "endMs": 5700,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "看！一下子高了这么多！农夫得意地笑了。",
