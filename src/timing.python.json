          "durationInFrames": 371,
          "durationSeconds": 12.353
        },
        {
          "index": 6,
          "file": "p04-6.m4a",
          "text": "生成器 → 迭代器协议 → 异步迭代器：同一条思想链",
          "startFrame": 1951,
          "durationInFrames": 361,
          "durationSeconds": 12.028
        }
      ]
    },
