  ],
  "garden": [
    {
      "text": "从前，有位农夫种了一田小苗。嫩绿的小叶子，真可爱！",
      "startMs": 800,
      "endMs": 6266.666666666667,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "他每天都去看，盼着小苗快快长高。",
