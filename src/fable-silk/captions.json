      "endMs": 10166.666666666666,
      "timestampMs": null,
      "confidence": null
    }
  ],
  "lunge": [
    {
      "text": "螳螂盯上了快织好的茧，猛地一扑。",
      "startMs": 800,
      "endMs": 3766.6666666666665,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "哎呀！风一吹，桑叶一晃，就差那么一点点。",
      "startMs": 4233.333333333333,
      "endMs": 8166.666666666666,
      "timestampMs": null,
      "confidence": null
    }
  ],
  "again": [
    {
      "text": "它不服气，第二扑，第三扑，每一次都扑了个空。",
      "startMs": 800,
      "endMs": 5133.333333333334,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "大刀砍在桑枝上，只落得几片叶子。",
      "startMs": 5600,
      "endMs": 8900,
      "timestampMs": null,
      "confidence": null
    }
  ],
  "cocoon": [
    {
      "text": "而蚕的茧，一层又一层，织得又厚又结实。",
      "startMs": 800,
      "endMs": 5133.333333333334,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "它在茧里安安稳稳，睡了一个长长的觉。",
      "startMs": 5600,
      "endMs": 8900,
      "timestampMs": null,
      "confidence": null
    }
  ],
  "winter": [
    {
      "text": "北风一吹，雪花落下来，螳螂又冷又饿，没处可去。",
